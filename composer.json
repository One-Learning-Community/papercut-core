{
    "name": "quoin/core",
    "description": "Page-aware PDF and HTML documents for modern PHP, built from typed, immutable components.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/One-Learning-Community/quoin",
    "support": {
        "issues": "https://github.com/One-Learning-Community/quoin/issues",
        "source": "https://github.com/One-Learning-Community/quoin",
        "docs": "https://one-learning-community.github.io/quoin/guide/"
    },
    "authors": [
        {
            "name": "One Learning Community",
            "role": "Maintainer"
        }
    ],
    "keywords": [
        "pdf",
        "pdf-generator",
        "layout",
        "flexbox",
        "document",
        "invoice",
        "report"
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "dskripchenko/php-pdf": "^1.26",
        "phactorial/phactorial": "^0.21"
    },
    "require-dev": {
        "bacon/bacon-qr-code": "^3.1",
        "phiki/phiki": "^2.2",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "bacon/bacon-qr-code": "Draw styled QR codes: dotted or rounded modules, eye shapes and colors, gradients",
        "ext-gd": "Read WebP, GIF, BMP and AVIF images (PNG and JPEG work without it)",
        "phiki/phiki": "Syntax highlighting in code blocks (TextMate grammars and themes)"
    },
    "autoload": {
        "psr-4": {
            "Quoin\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Quoin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.20.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
